# COPY THIS FILE TO .env (or .env.local) BEFORE RUNNING.
# The paths below are conventional route GUESSES for the 9 original APIs:
# confirm every path against your own FastAPI /docs before production use.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_KG_DRUG_API_PATH=/drug_smiles/find_all
VITE_KG_PROTEIN_API_PATH=/proteins/find_all
VITE_KG_DRUG_PROTEIN_API_PATH=/drug_proteins/find_all
VITE_KG_GENE_API_PATH=/kegg_gene/find_all
VITE_KG_PATHWAY_API_PATH=/pathway/find_all
VITE_KG_GENE_PATHWAY_API_PATH=/kegg_gene_pathway/find_all
VITE_KG_PROTEIN_GENE_API_PATH=/unit_protein_kegg_gene/find_all
VITE_KG_DISEASE_API_PATH=/disease_human/find_all
# Gene–Disease endpoint verified in Swagger; enabled to render API associations.
# Set false to disable this source, or true in your existing .env to enable it.
VITE_KG_ENABLE_GENE_DISEASE=true
VITE_KG_GENE_DISEASE_USE_PROXY=true
VITE_KG_GENE_DISEASE_API_PATH=/human_gene_disease/find_all

# 3 additional core APIs previously confirmed in Swagger:
VITE_KG_ADR_LLT_API_PATH=/adr_llt/find_all
VITE_KG_DRUG_ADR_LLT_API_PATH=/drug_adr/find_all
VITE_KG_ADR_HPO_API_PATH=/adr_hpo/find_all

# HPO term catalog is ACTIVE by default and attempts the route below.
# This URL is a conventional guess; confirm the exact route in FastAPI /docs.
VITE_KG_ENABLE_HPO=true
VITE_KG_HPO_API_PATH=/human_phenotype_ontology/find_all

# Other optional models remain DISABLED until explicitly configured.
# Disease→HPO relation source (NOT the human_phenotype_ontology catalog).
# VERIFY this conventional path against your own FastAPI /docs.
# If your route is /disease_to_human_phenotype/find_all, replace the path below.
# A missing endpoint now raises a visible error; NO synthetic edges are created.
VITE_KG_ENABLE_MONDO_HPO=true
VITE_KG_MONDO_HPO_USE_PROXY=true
VITE_KG_MONDO_HPO_API_PATH=/mondo_human_phenotype/find_all
# VITE_KG_KEGG_DISEASE_API_PATH=/kegg_disease/find_all
# VITE_KG_KEGG_NETWORK_API_PATH=/kegg_network/find_all
# VITE_KG_KEGG_DRUG_TARGET_API_PATH=/kegg_drug_target/find_all
# VITE_KG_KEGG_ELEMENT_API_PATH=/kegg_element/find_all
# VITE_KG_KEGG_INFO_API_PATH=/kegg_information/find_all
# VITE_KG_PROTEIN_SEQUENCE_API_PATH=/protein_sequence/find_all
